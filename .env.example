# Copy to .env.local and fill in. Values below match `npx supabase start` (local development).

# Public: safe to expose to the browser. Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# The publishable key (sb_publishable_...) or the legacy anon key. NEXT_PUBLIC_SUPABASE_ANON_KEY also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# Server-only: never prefix with NEXT_PUBLIC_. Postgres connection used by the game server.
# In production use the Supabase pooler ("Transaction" mode, port 6543) connection string.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Optional: max connections per server instance (default 5).
# DATABASE_POOL_MAX=5
